{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "redot": {
      "type": "local",
      "command": [
        "E:\\GameDevelopment\\RedotEngine\\redot.windows.editor.x86_64.llvm.console.exe",
        "--headless",
        "--mcp-server",
        "--quiet",
        "--path",
        "E:\\GameDevelopment\\RedotEngine\\Projects\\depth-10"
      ],
      "enabled": true,
      "timeout": 10000
    }
  },
  "permission": {
    "bash": {
      "E:\\GameDevelopment\\RedotEngine\\redot.windows.editor.x86_64.llvm.console.exe --headless *": "allow",
      "E:\\GameDevelopment\\RedotEngine\\redot.windows.editor.x86_64.llvm.exe --path *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "find *": "allow"
    }
  },
  "indexing": {
    "model": "BGE-M3:latest",
    "ollama": {
      "baseUrl": "http://localhost:11434"
    },
    "vectorStore": "qdrant",
    "qdrant": {
      "url": "http://localhost:6333"
    },
    "dimension": 1024,
    "searchMaxResults": 20,
    "fileExtensions": [
      ".bash", ".bazel", ".bzl", ".build", ".gradle", ".ninja", ".sh", ".zsh",
      ".css", ".ejs", ".erb", ".htm", ".html", ".js", ".jsx", ".ts", ".tsx", ".vue",
      ".c", ".cpp", ".cs", ".go", ".h", ".hpp", ".m", ".mm", ".rs", ".swift", ".zig",
      ".ex", ".exs", ".java", ".kt", ".kts", ".scala", ".dart", ".el", ".elm", ".lua",
      ".php", ".py", ".r", ".rb", ".vb", ".ml", ".mli", ".ql", ".rdl", ".res", ".resi",
      ".sol", ".tla", ".json", ".markdown", ".md", ".rst", ".sql", ".toml", ".yaml", ".yml",
      ".gd", ".gdshader", ".godot"
    ]
  }
}
